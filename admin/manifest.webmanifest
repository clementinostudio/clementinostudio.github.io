{
  "name": "Painel CapStudio",
  "short_name": "Painel",
  "description": "Pedidos, fábricas e vendedores da CapStudio.",
  "id": "/admin/",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#0b0b0b",
  "theme_color": "#0b0b0b",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "/admin/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Quadro de pedidos", "short_name": "Quadro", "url": "/admin/?v=quadro", "icons": [{ "src": "/admin/atalhos/quadro.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Buscar pedido", "short_name": "Buscar", "url": "/admin/?v=lista&busca=1", "icons": [{ "src": "/admin/atalhos/pedidos.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Avisos", "short_name": "Avisos", "url": "/admin/?a=avisos", "icons": [{ "src": "/admin/atalhos/avisos.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Fornecedores", "short_name": "Fábricas", "url": "/admin/?v=fabricas", "icons": [{ "src": "/admin/atalhos/fabricas.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
